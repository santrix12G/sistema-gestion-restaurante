# Copia este archivo como .env y completa los valores. .env no se sube al repositorio.

# Supabase > Connect > Session pooler (puerto 5432). Ver docs/base-de-datos.md
DATABASE_URL="postgresql://postgres.REF:CONTRASENA@REGION.pooler.supabase.com:5432/postgres?connection_limit=5"

# Contraseñas de los usuarios de demostración que crea npm run db:seed
SEED_ADMIN_PASSWORD=""
SEED_STAFF_PASSWORD=""

# Servidor
PORT=4000
# Direcciones desde las que se permite llamar a la API, separadas por coma
CORS_ORIGINS="http://localhost:3000"
# Firma las sesiones. Mínimo 32 caracteres. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# --- Chatbot de WhatsApp (ver docs/whatsapp.md) ---
# simulado: WhatsApp sin conectar (no envía nada; el bot puede atender por Telegram). twilio o meta: WhatsApp real
WHATSAPP_PROVIDER="simulado"

# Twilio (WHATSAPP_PROVIDER="twilio"). Twilio Console > Account Info
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Número de WhatsApp de Twilio. En el Sandbox es +14155238886
TWILIO_WHATSAPP_NUMBER=""
# Opcional: la URL exacta del webhook que pusiste en Twilio, si la API no la deduce bien detrás de un proxy
TWILIO_WEBHOOK_URL=""

# Meta (WHATSAPP_PROVIDER="meta")
# Lo inventas tú y lo escribes igual en Meta al registrar el webhook
META_VERIFY_TOKEN=""
# Meta > tu app > Configuración de la app > Básica > Clave secreta de la app
META_APP_SECRET=""
# Meta > WhatsApp > Configuración de la API: token de acceso e identificador del número de teléfono
META_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""
META_GRAPH_VERSION="v26.0"

# Telegram: con un token, el bot también atiende por Telegram, junto a WhatsApp. Se crea con @BotFather
TELEGRAM_BOT_TOKEN=""
# Solo en producción: con un secreto, Telegram entrega por webhook en lugar de sondeo. Ver docs/despliegue.md
TELEGRAM_WEBHOOK_SECRET=""
# Dirección pública de la API, sin /api. En Render no hace falta: se toma de RENDER_EXTERNAL_URL
API_PUBLIC_URL=""

# Quién atiende el chat. reglas: sin costo y sin red, con respuestas fijas.
# groq, claude u openai: un LLM conversa y arma el pedido con herramientas; si falla, responden las reglas. Ver docs/whatsapp.md
NLP_PROVIDER="reglas"
# Groq tiene plan gratuito. Clave en console.groq.com. Vacío usa openai/gpt-oss-120b
GROQ_API_KEY=""
GROQ_MODEL=""
ANTHROPIC_API_KEY=""
# Vacío usa claude-opus-5-5
ANTHROPIC_MODEL=""
OPENAI_API_KEY=""
OPENAI_MODEL=""

# Valor del domicilio en pesos
COSTO_DOMICILIO=5000

# --- Pago en línea con MercadoPago (ver docs/pagos.md) ---
# Sin token, el pago en línea queda apagado y el bot solo ofrece efectivo.
# MercadoPago > Tus integraciones > tu aplicación > Credenciales de prueba > Access Token (empieza con TEST- o APP_USR-)
MERCADOPAGO_ACCESS_TOKEN=""
# Obligatoria si hay token. Tus integraciones > tu aplicación > Webhooks > Clave secreta
MERCADOPAGO_WEBHOOK_SECRET=""
# Los avisos de pago llegan a API_PUBLIC_URL + /api/webhooks/mercadopago. En tu PC, API_PUBLIC_URL es la dirección del túnel

# --- Inicio de sesión y recuperación de contraseña (ver docs/seguridad-y-accesibilidad.md) ---
# Captcha Cloudflare Turnstile: dash.cloudflare.com > Turnstile > Add widget. Aquí va la clave secreta
# (la clave del sitio va en la web, NEXT_PUBLIC_TURNSTILE_SITE_KEY). Vacía: el inicio de sesión no pide captcha
TURNSTILE_SECRET_KEY=""
# Dirección de la web, para el enlace del correo de recuperación. Vacía: se usa la primera de CORS_ORIGINS
APP_WEB_URL=""
# Correo con Brevo (gratis, 300 al día): brevo.com > SMTP & API > API Keys. Render gratis bloquea SMTP, por eso se usa su API HTTP.
# Vacía: el correo no se envía y, fuera de producción, el enlace aparece en el log de la API
BREVO_API_KEY=""
# Remitente verificado en Brevo (Senders) y el nombre que verá quien lo recibe
CORREO_REMITENTE=""
CORREO_NOMBRE_REMITENTE="Restaurante"
