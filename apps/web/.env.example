# Copia este archivo como .env.local. Dirección de la API, terminada en /api
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Nombre que se muestra en el menú, en el inicio de sesión y en la pestaña del navegador
NEXT_PUBLIC_NOMBRE_RESTAURANTE="Restaurante"

# Datos del negocio en el tiquete del cliente (opcionales: si faltan, no salen)
NEXT_PUBLIC_TIQUETE_NIT=""
NEXT_PUBLIC_TIQUETE_DIRECCION=""
NEXT_PUBLIC_TIQUETE_TELEFONO=""
NEXT_PUBLIC_TIQUETE_MENSAJE="¡Gracias por tu compra!"

# --- Inicio de sesión y accesibilidad (ver docs/seguridad-y-accesibilidad.md) ---
# Captcha Cloudflare Turnstile: la clave del sitio (la secreta va en la API). Vacía: no se muestra captcha
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Correo de contacto que sale en el pie de página y en las políticas
NEXT_PUBLIC_CONTACTO_CORREO=""
# Dirección pública de esta web, para sitemap.xml y robots.txt (por ejemplo https://tu-web.vercel.app)
NEXT_PUBLIC_SITIO_URL=""
